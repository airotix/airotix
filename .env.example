# ─────────────────────────────────────────────────────────────
# AIROTIX environment variables
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# IMPORTANT: Never commit real secrets. The `.env` file is gitignored.
# ─────────────────────────────────────────────────────────────

# OpenRouter API Key (SERVER-SIDE ONLY — used by the /api/chat function).
# Get yours at https://openrouter.ai/keys
# In production, set this in Vercel: Settings → Environment Variables.
# Do NOT prefix with VITE_ — it must never reach the browser.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Chat request timeout in milliseconds (defaults to 25000).
# Used by the /api/chat serverless function to return a graceful error
# if the AI provider is slow, instead of hitting the platform hard limit.
CHAT_TIMEOUT_MS=25000

# Local development server port (optional, defaults to 3001).
# Only used by the local Express dev server (server/), not in production.
PORT=3001